---
import { Wrench } from "@lucide/astro";

interface Props {
	name: string;
	summary: string;
}

const { name, summary } = Astro.props;
---

<div class="tool-call">
	<Wrench aria-hidden="true" size={15} />
	<span class="visually-hidden">Tool call:</span>
	<code>{name}</code>
	<span class="separator" aria-hidden="true">·</span>
	<span class="summary">{summary}</span>
</div>

<style>
	.tool-call {
		display: flex;
		box-sizing: border-box;
		gap: 0.45rem;
		align-items: baseline;
		width: fit-content;
		max-width: 100%;
		margin-inline: 0.5rem;
		padding: 0.45rem 0.65rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		background: var(--sl-color-gray-7);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
	}

	.tool-call svg {
		flex: none;
		position: relative;
		top: 0.15rem;
		color: var(--sl-color-gray-3);
	}

	.tool-call code {
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--sl-color-text-accent);
		font-size: inherit;
		font-weight: 600;
	}

	.separator {
		color: var(--sl-color-gray-4);
	}

	.summary {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
