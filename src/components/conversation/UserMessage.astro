---
import { UserRound } from "@lucide/astro";
---

<div class="message user-message">
	<div class="message-heading">
		<UserRound aria-hidden="true" size={17} />
		<span>You</span>
	</div>
	<div class="message-content">
		<slot />
	</div>
</div>

<style>
	.message {
		box-sizing: border-box;
		width: 90%;
		min-width: 0;
		padding: 0.85rem 1rem;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-gray-5));
		border-radius: 0.75rem 0.75rem 0.2rem 0.75rem;
		background: color-mix(in srgb, var(--sl-color-accent-low) 45%, var(--sl-color-bg));
		justify-self: end;
	}

	.message-heading {
		display: flex;
		gap: 0.4rem;
		align-items: center;
		margin-bottom: 0.4rem;
		color: var(--sl-color-accent-high);
		font-size: var(--sl-text-xs);
		font-weight: 700;
		text-transform: uppercase;
	}

	.message-content {
		font-size: var(--sl-text-sm);
		line-height: 1.65;
	}

	.message-content :global(> :first-child) {
		margin-top: 0;
	}

	.message-content :global(> :last-child) {
		margin-bottom: 0;
	}
</style>
